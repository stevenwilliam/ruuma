<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only the pages worth indexing. Individual dishes (/menu/:id) are deliberately
  absent: their ids are UUIDv7 and the menu is per-store and changes with
  availability, so a static file would list URLs that 404 or show a sold-out
  item. When dish pages are worth indexing they need generating from the
  catalogue at build time, not hand-maintaining here.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://ruuma.id/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://ruuma.id/menu</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://ruuma.id/credits</loc>
    <changefreq>monthly</changefreq>
    <priority>0.1</priority>
  </url>
</urlset>
