# ruuma — environment. Copy to .env and fill in. NEVER commit .env.
#
# Business configuration does NOT live here — it lives in the sys_parameters
# table with admin CRUD (BR-1.4.1). This file is infrastructure and secrets only.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://ruuma.claudedev.local
APP_ADMIN_BASE_URL=http://ruuma.claudedev.local/admin
LOG_LEVEL=info                      # debug | info | warn | error
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://ruuma.claudedev.local

# ── Database (native PostgreSQL 18 on this server — D10) ──────────────────────
DATABASE_URL=postgres://ruuma:CHANGE_ME@127.0.0.1:5432/ruuma?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
TEST_DATABASE_URL=postgres://ruuma:CHANGE_ME@127.0.0.1:5432/ruuma_test?sslmode=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_BASE64_48_BYTES
JWT_PREVIOUS_KEY=                   # set during key rotation, then clear (docs/09 §3)
JWT_ISSUER=ruuma

# OAuth — flows are built but stay disabled until credentials exist (Q8).
# Enable per provider in sys_parameters: auth.provider_google_enabled / _instagram_enabled
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://ruuma.claudedev.local/api/v1/auth/oauth/google/callback
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URL=http://ruuma.claudedev.local/api/v1/auth/oauth/instagram/callback

# ── Object storage (MinIO via docker compose; private bucket, presigned only) ──
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=ruuma-dev
MINIO_SECRET_KEY=ruuma-dev-secret
MINIO_BUCKET=ruuma
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9002   # used to build presigned URLs

# ── Mail (mailpit in dev; real SMTP in production — Q9) ───────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ruuma.id
SMTP_FROM_NAME=ruuma
SMTP_TLS=false

# ── WhatsApp (shared WAHA container — D11; switch provider in sys_parameters) ─
WAHA_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_API_KEY=
# Meta Cloud API — the documented production alternative, stub in phase 1
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# ── Payments (phase 3 — QRIS/gateway webhook, D25) ───────────────────────────
PAYMENT_WEBHOOK_SECRET=
